# Copy this file to ".env" and edit.

# ---- LLM ------------------------------------------------------------------
# openai | gemini | ollama | mock (mock = offline fake, for testing only)
LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini          # leave empty for the default of the provider
OPENAI_API_KEY=
# GOOGLE_API_KEY=                # if LLM_PROVIDER=gemini

# ---- Embeddings -------------------------------------------------------------
# huggingface (free, local, multilingual) | openai | fake (offline testing only)
EMBEDDING_PROVIDER=huggingface
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ---- Retrieval ----------------------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4

# ---- Memory -------------------------------------------------------------------
# buffer = full history | summary_buffer = last N turns + running summary
MEMORY_MODE=buffer
SUMMARY_MAX_TURNS=6

# ---- Google Sheets ------------------------------------------------------------
# Share each sheet as "Anyone with the link: Viewer", then paste the links
# (comma separated, optional "name=" prefix). Leave empty to use data/sheets/*.csv
# SHEET_URLS=courses=https://docs.google.com/spreadsheets/d/XXXX/edit?gid=0,fees=https://docs.google.com/spreadsheets/d/YYYY/edit?gid=0
SHEET_URLS=
